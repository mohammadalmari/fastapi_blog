# Copy to .env for local development:  cp .env.example .env
# Real environment variables always win over this file.

# --- Core ---
# true = development (interactive docs, relaxed password rules, permissive CORS,
# insecure-key fallback, readable log lines). Unset/false = production
# hardening. The safe value is the default.
FASTAPI_DEBUG=true

# Signs the JWTs and keys the rate-limit counters. Required (min 32 chars)
# whenever FASTAPI_DEBUG is not true.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
FASTAPI_SECRET_KEY=

# Comma-separated. Required whenever FASTAPI_DEBUG is not true;
# localhost/127.0.0.1 are added automatically in DEBUG.
FASTAPI_ALLOWED_HOSTS=

# --- Database ---
# e.g. mongodb://user:pass@host:27017/?replicaSet=rs0
# MongoDB must be a replica set (a single node is enough): the app uses
# transactions. Defaults to mongodb://localhost:27017/?replicaSet=rs0 when unset.
DATABASE_URL=
# Defaults to fastapi_blog
DATABASE_NAME=
# Optional: a separate MongoDB for the tests. Defaults to DATABASE_URL.
# The tests create and drop their own randomly named database on it.
TEST_DATABASE_URL=

# --- CORS ---
# Comma-separated origins, scheme included, e.g. https://app.example.com
# Ignored in DEBUG, where any origin is allowed.
FASTAPI_CORS_ALLOWED_ORIGINS=
# Set to true if a browser frontend on another origin must send the refresh cookie.
FASTAPI_CORS_ALLOW_CREDENTIALS=false

# --- Tokens ---
# Defaults: 15 minutes / 14 days
FASTAPI_ACCESS_TOKEN_TTL_MINUTES=
FASTAPI_REFRESH_TOKEN_TTL_DAYS=

# --- Uploads ---
# Where uploaded avatars are stored. Defaults to media/ at the repo root.
# The app checks at startup that it can write here. In a real deployment point
# it at a disk that outlives the container, e.g. a mounted volume.
FASTAPI_MEDIA_DIR=

# --- Caching ---
# How long each worker remembers the list of tags, in whole seconds.
# 0 counts them on every request. Default: 60
FASTAPI_TAGS_CACHE_SECONDS=

# --- Logging ---
# Root/console/app log level (DEBUG, INFO, WARNING, ...); default INFO
FASTAPI_LOG_LEVEL=
# Production only: rotating error.log + security.log live here, one JSON
# object per line. Defaults to logs/ at the repo root; point it at a system
# path in a real deployment, e.g. /var/log/fastapi-blog
FASTAPI_LOG_DIR=
# Rotation tuning; defaults: 10485760 (10 MB) per file, 5 backups
FASTAPI_LOG_MAX_BYTES=
FASTAPI_LOG_BACKUP_COUNT=
